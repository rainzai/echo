# bluebubbles
BLUEBUBBLES_URL=http://127.0.0.1:1234
BLUEBUBBLES_PASSWORD=

# go server
PORT=8080

# dealcheck, e.g. http://127.0.0.1:8000. empty uses fake checks
DEALCHECK_URL=

# gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# takes over a step when the main model answers empty
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# low, medium, high or xhigh
GEMINI_THINKING=low

# nemotron
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
